node_modules/
.DS_Store
# Android build output and signing keys: never commit a keystore
android/build/
# the Play bundles and the last one's check APK (PLAY=1 ./build-apk.sh)
android/build-play/
# Gradle's own folders (Version 39.79): its build output and its cache for this project
android/build-gradle/
android/.gradle/
# Firebase's settings for the app (Version 39.79): from the Firebase console, kept out of git like the keys
android/google-services.json
*.aab
*.apk
*.idsig
*.keystore
*.jks
# Test output
web/test/shots/
web/test/_care/
# Care near me data, made by web/tools/care-data.mjs from data.gov.in (see docs/care-near-me-data-2026-10-22.md)
web/care/
web/test/report-*.json
# Server secrets and data exports (exports hold phone numbers)
server/.env*
server/exports/
*.sql.gz
# The data.gov.in lists the Care data is rebuilt from (node web/tools/care-data.mjs --from web/tools/care-src)
web/tools/care-src/
# Google Play's graphics (marketing/play-store/make-play-graphics.mjs): its raw screens, the 6 Nov set it replaced, and the
# full-size foreground-service recording (43 MB; the 540p copy beside it is in git)
marketing/play-store/build/
marketing/play-store/old-2026-11-06/
marketing/play-store/winddown-foreground-service.mp4
